{
  "name": "essential-store-editorial-v2",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "syntax": "node scripts/check-syntax.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "admin:setup": "node --env-file=.env scripts/setup-admin.mjs",
    "db:seed": "node scripts/seed-storefront-demo.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "lucide-react": "^0.468.0",
    "gsap": "^3.15.0",
    "@aws-sdk/client-s3": "^3.900.0",
    "@prisma/client": "^6.19.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.2",
    "typescript": "^5.8.3",
    "prisma": "^6.19.0"
  },
  "engines": {
    "node": ">=22"
  }
}
